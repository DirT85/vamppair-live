# Use a reliable mainnet HTTPS RPC. Never expose this URL in NEXT_PUBLIC_*.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only IPFS credential. Create a free Pinata JWT and keep it secret.
PINATA_JWT=

# Optional public Solana RPC used by the browser to send the signed transaction.
# If omitted, the app uses /api/rpc so provider keys stay server-side.
NEXT_PUBLIC_SOLANA_RPC_URL=
